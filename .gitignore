# ===== 小红书：密钥与登录态（绝不提交）=====
xhs/feishu/feishu_app.json
xhs/monitor/login_cookies.txt
xhs/monitor/login_cookies.bak
xhs/monitor/login_cookies.txt.tmp
xhs/monitor/login_qr.png
xhs/monitor/*.svg
xhs/monitor/logs/
xhs/deliveries/*
!xhs/deliveries/.gitkeep
xhs/monitor/*.venv/
xhs/.venv/

# ===== 抖音：运行时配置（含 cookie）与产物 =====
douyin/config/config.ini
douyin/config/URL_config.ini
douyin/downloads/*
!douyin/downloads/.gitkeep
douyin/logs/*
!douyin/logs/.gitkeep
douyin/backup_config/
douyin/minutes/
douyin/.venv/

# ===== Docker 运行时数据（凭证、录像、日志、cookie）=====
data/xhs/*
!data/xhs/.gitkeep
!data/xhs/feishu_app.example.json
data/douyin/*
!data/douyin/.gitkeep
!data/douyin/config
data/douyin/config/*
!data/douyin/config/config.ini.example
!data/douyin/config/URL_config.ini.example

# ===== Python =====
__pycache__/
*.pyc
venv/

# ===== 通用运行时产物 =====
*.ts
*.mp4
*.m4a
*.log
signal_state.json
status.json

# ===== 系统 =====
.DS_Store
