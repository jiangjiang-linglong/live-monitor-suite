# 抖音（及多平台）录播器
# 构建上下文为 douyin/：docker build -f ../docker/Dockerfile.douyin -t live-monitor-douyin .
FROM python:3.11-slim

# 国内镜像源（apt 阿里云 + pip 清华）；海外机器可删本段 sed 与 -i 参数
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g; s|security.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        nodejs \
        tzdata \
        ca-certificates \
    && ln -fs /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple -r /app/requirements.txt

COPY . /app
RUN chmod +x /app/docker-entrypoint.sh && mkdir -p /app/downloads /app/logs \
    && cp -r /app/config /opt/config-examples

ENV TZ=Asia/Shanghai \
    PYTHONUNBUFFERED=1 \
    TERM=xterm-256color

ENTRYPOINT ["/app/docker-entrypoint.sh"]
